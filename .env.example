# work-fold normally stores provider credentials through Pi's auth flow.
# Environment variables are convenient for local development and CI only.

OPENROUTER_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
# GEMINI_API_KEY=replace-me

# Railway CLI authentication belongs in the ignored .env.railway.local file.
# Use exactly one token type: prefer a project-scoped token once the project exists.
# RAILWAY_TOKEN=replace-me
# RAILWAY_API_TOKEN=replace-me

# Optional development overrides.
# WORKFOLD_LOCAL_API_PORT=4327
# PI_AGENT_DIR=/absolute/path/to/an/isolated/pi-agent-directory
