# work-fold normally stores provider credentials through Pi's auth flow.
# Environment variables are convenient for local development and CI only.

# OPENROUTER_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# OPENAI_API_KEY=replace-me
# GEMINI_API_KEY=replace-me

# Railway CLI authentication belongs in the ignored .env.railway.local file.
# Use exactly one token type: prefer a project-scoped token once the project exists.
# RAILWAY_TOKEN=replace-me
# RAILWAY_API_TOKEN=replace-me

# Optional development overrides.
# WORKFOLD_LOCAL_API_PORT=4327
# WORKFOLD_AGENT_DIR=/absolute/path/to/an/isolated/pi-agent-directory
# WORKFOLD_STATE_DIR=/absolute/path/to/browser-development-state
# WORKFOLD_DESKTOP_STATE_DIR=/absolute/path/to/electron-development-state

# Publishing pages from `npm run local:dev` (see docs/development.md): a
# development bridge you run and a device token it issued.
# WORKFOLD_DEV_BRIDGE_URL=http://127.0.0.1:8790
# WORKFOLD_DEV_DEVICE_TOKEN=replace-me
