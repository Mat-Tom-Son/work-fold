+async function companionHeaders() {
+  const config = await loadCompanionConfig();
+  return config.mode === "embedded" ? { "x-pi-chrome-companion": config.token, ...(config.connectionId ? { "x-pi-chrome-connection": config.connectionId } : {}) } : {};
