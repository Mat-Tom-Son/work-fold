new file mode 100644
index 0000000..d398b21
--- /dev/null
+++ b/native/linux/bridge-rs/src/atspi/validation.rs
@@ -0,0 +1,116 @@
+use super::*;
+
+pub(super) fn process_instance(pid: u64) -> Option<String> {
+    let stat = std::fs::read_to_string(format!("/proc/{pid}/stat")).ok()?;
+    stat.get(stat.rfind(')')? + 1..)?
+        .split_whitespace()
+        .nth(19)
+        .map(str::to_owned)
+}
+
+fn stale(message: &str) -> ProtocolError {
+    ProtocolError::new(
+        format!("{message}; find and observe the target again"),
+        ErrorCode::StaleRef,
+    )
+}
+
+impl AtspiClient {
+    pub(super) async fn identity_fields(
+        &self,
+        node: &AccessibleRef,
+    ) -> (String, String, String, HashSet<String>, bool) {
+        let Ok(proxy) = self.proxy(node, ACCESSIBLE).await else {
+            return (
+                String::new(),
+                String::new(),
+                String::new(),
+                HashSet::new(),
+                false,
+            );
+        };
+        let role = proxy.call::<_, _, String>("GetRoleName", &()).await;
+        let name = proxy.get_property::<String>("Name").await;
+        let description = proxy.get_property::<String>("Description").await;
+        let interfaces = proxy.call::<_, _, Vec<String>>("GetInterfaces", &()).await;
+        let readable = role.as_ref().is_ok_and(|role| !role.is_empty())
+            && name.is_ok()
+            && description.is_ok()
+            && interfaces.is_ok();
+        (
+            role.unwrap_or_default(),
+            name.unwrap_or_default(),
+            description.unwrap_or_default(),
+            interfaces.unwrap_or_default().into_iter().collect(),
+            readable,
+        )
+    }
+
+    /// Addresses are lookup hints. Recheck ownership, ancestry and stable
+    /// evidence before delivering any effect to an observed control.
+    pub async fn validate_node(
+        &self,
+        root: &RootSnapshot,
+        nodes: &HashMap<String, NodeSnapshot>,
+        node: &NodeSnapshot,
+    ) -> Result<NodeSnapshot, ProtocolError> {
+        if root.process_instance.is_none()
+            || root.process_instance != process_instance(root.pid)
+            || self.application_pid(&root.accessible).await != root.pid
+        {
+            return Err(stale(
+                "The owning application changed or cannot be identified",
+            ));
+        }
+        let roots = self.list_roots(Some(root.pid)).await?;
+        if !roots.iter().any(|live| live.accessible == root.accessible) {
+            return Err(stale("The observed window is no longer registered"));
+        }
+        let mut current = node;
+        let mut seen = HashSet::new();
+        while current.accessible != root.accessible {
+            if !seen.insert(current.accessible.clone()) {
+                return Err(stale("The observed ancestry is cyclic"));
+            }
+            let parent = current
+                .parent
+                .as_ref()
+                .ok_or_else(|| stale("The control has no proven window ancestry"))?;
+            let children = self
+                .children(parent)
+                .await
+                .map_err(|_| stale("The control's parent could not be verified"))?;
+            if !children.contains(&current.accessible) {
+                return Err(stale("The control left its observed parent"));
+            }
+            if parent == &root.accessible {
+                break;
+            }
+            current = nodes
+                .values()
+                .find(|saved| &saved.accessible == parent)
+                .ok_or_else(|| stale("The control's ancestry is incomplete"))?;
+        }
+        let (role, name, description, interfaces, readable) =
+            self.identity_fields(&node.accessible).await;
+        let native_id = self.string_property(&node.accessible, "AccessibleId").await;
+        if !node.identity_readable
+            || !readable
+            || role != node.role
+            || name != node.name
+            || description != node.description
+            || (!node.native_id.is_empty() && native_id != node.native_id)
+            || (node.name.is_empty() && node.description.is_empty() && node.native_id.is_empty())
+        {
+            return Err(stale(
+                "The observed control's identity changed or is unreadable",
+            ));
+        }
+        let mut live = node.clone();
+        live.is_secure =
+            role.eq_ignore_ascii_case("password text") || role.eq_ignore_ascii_case("password");
+        live.interfaces = interfaces;
+        live.bounds = self.bounds(&node.accessible).await;
+        Ok(live)
+    }
+}
