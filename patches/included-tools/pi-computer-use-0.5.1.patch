+import os from 'node:os';
+import path from 'node:path';
+const dir=await mkdtemp(path.join(os.tmpdir(),'pi-cu-cancel-'));const socketPath=path.join(dir,'helper.sock');
+process.env.PI_CU_SOCKET_PATH=socketPath;
+const completed=[];const ids=new Set();let accepted;let acceptedPromise=new Promise(resolve=>accepted=resolve);let mutations=0;let sockets=new Set();
+const server=net.createServer(socket=>{sockets.add(socket);socket.on('close',()=>sockets.delete(socket));let buffer='';socket.on('data',chunk=>{buffer+=chunk;const i=buffer.indexOf('\n');if(i<0)return;const req=JSON.parse(buffer.slice(0,i));assert(!ids.has(req.id), "request ids must remain unique across clients");ids.add(req.id);if(req.cmd==='diagnostics'){socket.end(JSON.stringify({id:req.id,ok:true,result:{recentCompletedRequestIds:completed}})+'\n');return}if(req.cmd==='mismatch'){socket.end(JSON.stringify({id:'wrong',ok:true,result:{}})+'\n');return}mutations++;accepted();socket.once('end',()=>{completed.push(req.id);socket.end()})})});
+await new Promise(resolve=>server.listen(socketPath,resolve));
+try{
+ const {MacosHelperClient}=await import('../src/platform/macos/helper.ts');const client=new MacosHelperClient();
+ const cancelled=new AbortController();cancelled.abort();await assert.rejects(()=>client.daemonCommand('act',{},1000,cancelled.signal),/aborted/);assert.equal(ids.size,0);
+ const live=new AbortController();const pending=client.daemonCommand('act',{},1000,live.signal);await acceptedPromise;live.abort();await assert.rejects(()=>pending,e=>e.code==='interrupted_unknown'&&/uncertain/.test(e.message));assert.equal(mutations,1,'cancellation must not redispatch');assert.equal(completed.length,1,'wait for helper acknowledgement before releasing active request');
+ await assert.rejects(()=>client.daemonCommand('mismatch',{},1000),/did not match/);
+ const second=new MacosHelperClient();await Promise.all([client.daemonCommand('diagnostics',{},1000),second.daemonCommand('diagnostics',{},1000)]);assert.equal(ids.size,new Set(ids).size);
+ console.log('PASS cancelled-before-dispatch, uncertain dispatched outcome, drained socket closure, no replay, response identity and concurrent clients');
+}finally{for(const socket of sockets)socket.destroy();await new Promise(r=>server.close(r));await rm(dir,{recursive:true,force:true})}
