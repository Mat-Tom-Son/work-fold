+import { execFile } from "node:child_process";
+import { createHash } from "node:crypto";
+import { lstat, readFile, readdir, realpath } from "node:fs/promises";
+import path from "node:path";
+import { promisify } from "node:util";
+
+const run = promisify(execFile);
+
+/** Gatekeeper may relocate an exact signed helper without changing its bytes.
+ * Retain the canonical-path fast path; never accept a relocated name or team
+ * alone. Both bounded bundles must be identical and independently sealed. */
+export async function verifyHelperExecutable(actual, expected, signal) {
+  signal?.throwIfAborted();
+  const [actualPath, expectedPath] = await Promise.all([
+    realpath(actual).catch(() => path.resolve(actual)),
+    realpath(expected).catch(() => path.resolve(expected)),
+  ]);
+  if (actualPath === expectedPath) return true;
+  if (process.platform !== "darwin") return false;
+  try {
+    if (actual.split(path.sep).includes("..")) return false;
+    // Unlike TMPDIR/os.tmpdir(), this system value cannot redirect validation
+    // into an environment-selected imitation of the translocation directory.
+    const result = await run("/usr/bin/getconf", ["DARWIN_USER_TEMP_DIR"], { timeout: 5_000, maxBuffer: 4096, signal });
+    const temporaryRoot = await realpath(result.stdout.trim());
+    const parts = path.relative(temporaryRoot, actualPath).split(path.sep);
+    const expectedApp = path.dirname(path.dirname(path.dirname(expectedPath)));
+    const actualApp = path.dirname(path.dirname(path.dirname(actualPath)));
+    // The randomised intermediate layout is not an Apple API. Only the user
+    // directory and the bundle's own executable matter; matching bytes below
+    // supply identity, rather than a UUID/name convention.
+    if (parts[0] !== "AppTranslocation" || parts.length < 5
+      || parts.slice(-3).join(path.sep) !== path.join("Contents", "MacOS", path.basename(expectedPath))
+      || path.basename(actualApp) !== path.basename(expectedApp) || !expectedApp.endsWith(".app")) return false;
+    const [actualDigest, expectedDigest] = await Promise.all([
+      bundleDigest(actualApp, signal), bundleDigest(expectedApp, signal),
+    ]);
+    if (actualDigest !== expectedDigest) return false;
+    const executable = await run("/usr/bin/plutil", ["-extract", "CFBundleExecutable", "raw", "-o", "-", path.join(expectedApp, "Contents", "Info.plist")], { timeout: 5_000, maxBuffer: 4096, signal });
+    if (executable.stdout.trim() !== path.basename(expectedPath)) return false;
+    // Code signatures are part of the digest too. Verification additionally
+    // rejects identical but unsealed copies. Never remove quarantine metadata.
+    for (const app of [expectedApp, actualApp]) {
+      try {
+        await run("/usr/bin/codesign", ["--verify", "--strict", app], { timeout: 10_000, signal });
+      } catch (error) {
+        if (Number.isInteger(error?.code) && !error.killed && !error.signal) return false;
+        throw error;
+      }
+    }
+    signal?.throwIfAborted();
+    return true;
+  } catch (error) {
+    signal?.throwIfAborted();
+    if (error instanceof HelperArtifactMismatch || error?.code === "ENOENT") return false;
+    // An inspection failure is not evidence of a different daemon. Surface it
+    // without asking ensureProtocol() to restart a possibly busy shared helper.
+    throw new Error("Unable to verify the running computer helper identity.", { cause: error });
+  }
+}
+
+class HelperArtifactMismatch extends Error {}
+
+async function bundleDigest(root, signal) {
+  const digest = createHash("sha256");
+  let entries = 0, bytes = 0;
+  async function visit(relative) {
+    signal?.throwIfAborted();
+    const filename = path.join(root, relative), info = await lstat(filename);
+    if (++entries > 128 || info.isSymbolicLink() || (!info.isDirectory() && !info.isFile())) throw new HelperArtifactMismatch("Unexpected helper contents.");
+    digest.update(`${info.isDirectory() ? "directory" : "file"}\0${relative}\0${info.mode & 0o777}\0`);
+    if (info.isDirectory()) {
+      for (const name of (await readdir(filename)).sort()) await visit(path.join(relative, name));
+    } else {
+      bytes += info.size;
+      if (bytes > 64 * 1024 * 1024) throw new HelperArtifactMismatch("Helper exceeds its expected size.");
+      digest.update(await readFile(filename)); digest.update("\0");
+    }
+  }
+  await visit("");
+  return digest.digest("hex");
+}
