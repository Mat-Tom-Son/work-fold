+export async function probeMacosComputerUse(options: { launch?: boolean; signal?: AbortSignal } = {}) {
+  if (process.platform !== "darwin" || Number.parseInt(release(), 10) < 23) return { status: "unavailable" as const, supportedOS: false, reason: "This included helper requires macOS 14 or later." };
