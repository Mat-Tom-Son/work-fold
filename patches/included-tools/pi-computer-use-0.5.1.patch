+        }
+    }
+}
+struct Bus(String);
+#[zbus::interface(name = "org.a11y.Bus")]
+impl Bus {
+    fn get_address(&self) -> &str {
+        &self.0
+    }
+}
+
+struct Accessible {
+    kind: &'static str,
+    state: Arc<Mutex<State>>,
+}
+#[zbus::interface(name = "org.a11y.atspi.Accessible")]
+impl Accessible {
+    fn get_children(&self) -> zbus::fdo::Result<Vec<(String, OwnedObjectPath)>> {
+        let state = self.state.lock().unwrap();
+        if self.kind == "window" && state.broken {
+            return Err(zbus::fdo::Error::Failed("unreadable children".into()));
+        }
+        let paths: Vec<&str> = match self.kind {
+            "registry" => vec!["/app"],
+            "app" => vec!["/window"],
+            "window" if state.detached => vec!["/editor"],
+            "window" => vec!["/button", "/editor"],
+            "button" => vec!["/nested"],
+            _ => vec![],
+        };
+        Ok(paths
+            .into_iter()
+            .map(|path| (state.bus.clone(), path.try_into().unwrap()))
+            .collect())
+    }
+    fn get_role_name(&self) -> &str {
+        match self.kind {
+            "window" => "frame",
+            "button" => "push button",
+            "editor" => "text",
+            "app" => "application",
+            _ => "label",
+        }
+    }
+    fn get_interfaces(&self) -> Vec<&str> {
+        let mut out = vec![ACC, "org.a11y.atspi.Component"];
+        if self.kind == "button" {
+            out.push(ACTION);
+        }
+        if self.kind == "editor" {
+            out.extend([TEXT, EDIT]);
+        }
+        out
+    }
+    #[zbus(property)]
+    fn name(&self) -> String {
+        if self.kind == "button" {
+            self.state.lock().unwrap().label.clone()
+        } else {
+            self.kind.into()
+        }
+    }
+    #[zbus(property)]
+    fn description(&self) -> &str {
+        ""
+    }
+    #[zbus(property)]
+    fn accessible_id(&self) -> &str {
+        self.kind
+    }
+}
+struct Component;
+#[zbus::interface(name = "org.a11y.atspi.Component")]
+impl Component {
+    fn get_extents(&self, _coordinate: u32) -> (i32, i32, i32, i32) {
+        (0, 0, 500, 300)
+    }
+}
+struct Action(Arc<Mutex<State>>);
+#[zbus::interface(name = "org.a11y.atspi.Action")]
+impl Action {
+    #[zbus(property)]
+    fn n_actions(&self) -> i32 {
+        1
+    }
+    fn get_name(&self, _index: i32) -> &str {
+        "click"
+    }
+    fn do_action(&self, _index: i32) -> zbus::fdo::Result<bool> {
+        let mut state = self.0.lock().unwrap();
+        state.effects += 1;
+        if state.error_after_effect {
+            Err(zbus::fdo::Error::Failed("reply lost after effect".into()))
+        } else {
+            Ok(true)
+        }
+    }
+}
+struct Text(Arc<Mutex<State>>);
+#[zbus::interface(name = "org.a11y.atspi.Text")]
+impl Text {
+    fn get_text(&self, start: i32, end: i32) -> String {
+        let state = self.0.lock().unwrap();
+        state
+            .value
+            .chars()
+            .skip(start.max(0) as usize)
+            .take(if end < 0 {
+                usize::MAX
+            } else {
+                (end - start).max(0) as usize
+            })
+            .collect()
+    }
+    #[zbus(property)]
+    fn caret_offset(&self) -> zbus::fdo::Result<i32> {
+        let state = self.0.lock().unwrap();
+        if state.caret_unreadable {
+            Err(zbus::fdo::Error::Failed("caret unavailable".into()))
+        } else {
+            Ok(state.caret)
+        }
+    }
+    fn get_n_selections(&self) -> i32 {
+        i32::from(self.0.lock().unwrap().selection.is_some())
+    }
+    fn get_selection(&self, _index: i32) -> (i32, i32) {
+        self.0.lock().unwrap().selection.unwrap()
+    }
+}
+struct Editable(Arc<Mutex<State>>);
+#[zbus::interface(name = "org.a11y.atspi.EditableText")]
+impl Editable {
+    fn set_text_contents(&self, text: &str) -> bool {
+        let mut state = self.0.lock().unwrap();
+        state.replacements += 1;
+        if !state.ignore {
+            state.value = text.into();
+        }
+        true
+    }
+    fn delete_text(&self, start: i32, end: i32) -> bool {
+        let mut state = self.0.lock().unwrap();
+        state.value = state
+            .value
+            .chars()
+            .enumerate()
+            .filter_map(|(i, c)| (!(start as usize..end as usize).contains(&i)).then_some(c))
+            .collect();
+        true
+    }
+    fn insert_text(&self, position: i32, text: &str, length: i32) -> bool {
+        let mut state = self.0.lock().unwrap();
+        state.insertions += 1;
+        assert_eq!(
+            length as usize,
+            if state.toolkit == "Qt" {
+                text.encode_utf16().count()
+            } else {
+                text.len()
+            }
+        );
+        if state.insert_false {
+            return false;
+        }
+        if !state.ignore {
+            let mut chars: Vec<char> = state.value.chars().collect();
+            chars.splice(position as usize..position as usize, text.chars());
+            state.value = chars.into_iter().collect();
+        }
+        true
+    }
+}
+struct Application(Arc<Mutex<State>>);
+#[zbus::interface(name = "org.a11y.atspi.Application")]
+impl Application {
+    #[zbus(property)]
+    fn toolkit_name(&self) -> String {
+        self.0.lock().unwrap().toolkit.clone()
+    }
+}
+
+struct Fixture {
+    daemon: Child,
+    helper: Child,
+    output: BufReader<std::process::ChildStdout>,
+    _connection: zbus::Connection,
+    state: Arc<Mutex<State>>,
+    root: String,
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        let _ = self.helper.kill();
+        let _ = self.helper.wait();
+        let _ = self.daemon.kill();
+        let _ = self.daemon.wait();
+    }
+}
+impl Fixture {
+    async fn new() -> Self {
+        let mut daemon = Command::new("dbus-daemon")
+            .args(["--session", "--nofork", "--print-address=1"])
+            .stdout(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let mut address = String::new();
+        BufReader::new(daemon.stdout.take().unwrap())
+            .read_line(&mut address)
+            .unwrap();
+        let address = address.trim().to_owned();
+        let state = Arc::new(Mutex::new(State::default()));
+        let connection = zbus::connection::Builder::address(address.as_str())
+            .unwrap()
+            .build()
+            .await
+            .unwrap();
+        state.lock().unwrap().bus = connection.unique_name().unwrap().to_string();
+        connection
+            .object_server()
+            .at("/org/a11y/bus", Bus(address.clone()))
+            .await
+            .unwrap();
+        for (path, kind) in [
+            ("/org/a11y/atspi/accessible/root", "registry"),
+            ("/app", "app"),
+            ("/window", "window"),
+            ("/button", "button"),
+            ("/editor", "editor"),
+            ("/nested", "label"),
+        ] {
+            connection
+                .object_server()
+                .at(
+                    path,
+                    Accessible {
+                        kind,
+                        state: state.clone(),
+                    },
+                )
+                .await
+                .unwrap();
+            connection
+                .object_server()
+                .at(path, Component)
+                .await
+                .unwrap();
+        }
+        connection
+            .object_server()
+            .at("/button", Action(state.clone()))
+            .await
+            .unwrap();
+        connection
+            .object_server()
+            .at("/app", Application(state.clone()))
+            .await
+            .unwrap();
+        connection
+            .object_server()
+            .at("/editor", Text(state.clone()))
+            .await
+            .unwrap();
+        connection
+            .object_server()
+            .at("/editor", Editable(state.clone()))
+            .await
+            .unwrap();
+        connection.request_name("org.a11y.Bus").await.unwrap();
+        connection
+            .request_name("org.a11y.atspi.Registry")
+            .await
+            .unwrap();
+        let mut helper = Command::new(env!("CARGO_BIN_EXE_linux-bridge"))
+            .env("DBUS_SESSION_BUS_ADDRESS", address)
+            .env("XDG_SESSION_TYPE", "x11")
+            .env_remove("DISPLAY")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .spawn()
+            .unwrap();
+        let output = BufReader::new(helper.stdout.take().unwrap());
+        let mut fixture = Self {
+            daemon,
+            helper,
+            output,
+            _connection: connection,
+            state,
+            root: String::new(),
+        };
+        fixture.root = fixture.call("listRoots", json!({"pid":std::process::id()}))["result"]
+            ["roots"][0]["rootRef"]
+            .as_str()
+            .unwrap()
+            .into();
+        fixture
+    }
+    fn call(&mut self, cmd: &str, args: Value) -> Value {
+        writeln!(
+            self.helper.stdin.as_mut().unwrap(),
+            "{}",
+            json!({"protocolVersion":4,"id":cmd,"cmd":cmd,"args":args})
+        )
+        .unwrap();
+        let mut line = String::new();
+        self.output.read_line(&mut line).unwrap();
+        serde_json::from_str(&line).unwrap()
+    }
+    fn look(&mut self) -> Value {
+        self.call("look", json!({"rootRef":self.root,"includeImage":false}))["result"].clone()
+    }
+    fn request(look: &Value, title: &str, action: &str, text: &str) -> Value {
+        let node = look["outline"]["children"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|node| node["title"] == title)
+            .unwrap();
+        json!({"lookId":look["lookId"],"action":action,"target":{"ref":node["ref"]},"params":{"text":text},"policy":"ax_only"})
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn changed_or_detached_controls_refuse_without_effects() {
+    let mut f = Fixture::new().await;
+    let look = f.look();
+    f.state.lock().unwrap().label = "Send payment".into();
+    let r = f.call("act", Fixture::request(&look, "Save draft", "press", ""));
+    assert_eq!(r["error"]["code"], "stale_ref", "{r}");
+    assert_eq!(f.state.lock().unwrap().effects, 0);
+    f.state.lock().unwrap().label = "Save draft".into();
+    f.state.lock().unwrap().detached = true;
+    let r = f.call("act", Fixture::request(&look, "Save draft", "press", ""));
+    assert_eq!(r["error"]["code"], "stale_ref", "{r}");
+    assert_eq!(f.state.lock().unwrap().effects, 0);
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn ignored_text_is_not_success_or_requested_value_evidence() {
+    let mut f = Fixture::new().await;
+    let look = f.look();
+    f.state.lock().unwrap().ignore = true;
+    let r = f.call(
+        "act",
+        Fixture::request(&look, "editor", "setText", "expected"),
+    );
+    assert_eq!(r["result"]["outcome"], "didnt", "{r}");
+    assert_ne!(r["result"]["evidence"]["value"], "expected");
+    assert_eq!(f.state.lock().unwrap().value, "prefix");
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn post_dispatch_errors_stop_batches_as_unknown_without_replay() {
+    let mut f = Fixture::new().await;
+    let look = f.look();
+    f.state.lock().unwrap().error_after_effect = true;
+    let action = Fixture::request(&look, "Save draft", "press", "");
+    let r = f.call("actBatch", json!({"actions":[action.clone(),action]}));
+    assert_eq!(r["result"]["outcome"], "unknown", "{r}");
+    assert_eq!(r["result"]["stoppedAt"], 0);
+    assert_eq!(f.state.lock().unwrap().effects, 1);
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn typing_inserts_at_caret_and_replaces_only_the_selection() {
+    let mut f = Fixture::new().await;
+    for (value, caret, selection, text, expected) in [
+        ("prefix", 6, None, "suffix", "prefixsuffix"),
+        ("a👩éz", 2, Some((1, 3)), "日本", "a日本z"),
+        ("ab", 1, Some((1, 1)), "é👩", "aé👩b"),
+    ] {
+        {
+            let mut s = f.state.lock().unwrap();
+            s.value = value.into();
+            s.caret = caret;
+            s.selection = selection;
+        }
+        let look = f.look();
+        let r = f.call("act", Fixture::request(&look, "editor", "typeText", text));
+        assert_eq!(f.state.lock().unwrap().value, expected, "{r}");
+        assert_eq!(r["result"]["outcome"], "worked", "{r}");
+    }
+    assert_eq!(f.state.lock().unwrap().replacements, 0);
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn failed_insert_after_selection_delete_remains_unknown() {
+    let mut f = Fixture::new().await;
+    f.state.lock().unwrap().selection = Some((0, 3));
+    f.state.lock().unwrap().insert_false = true;
+    let look = f.look();
+    let r = f.call(
+        "actBatch",
+        json!({"actions":[Fixture::request(&look,"editor","typeText","x")]}),
+    );
+    assert_eq!(r["result"]["outcome"], "unknown", "{r}");
+    assert_eq!(f.state.lock().unwrap().value, "fix");
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn qt_unicode_insertion_uses_its_toolkits_length_unit() {
+    let mut f = Fixture::new().await;
+    f.state.lock().unwrap().toolkit = "Qt".into();
+    f.call("listRoots", json!({"pid":std::process::id()}));
+    let look = f.look();
+    let r = f.call("act", Fixture::request(&look, "editor", "typeText", "é👩"));
+    assert_eq!(r["result"]["outcome"], "worked", "{r}");
+    assert_eq!(f.state.lock().unwrap().value, "prefixé👩");
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn unavailable_caret_refuses_before_any_text_mutation() {
+    let mut f = Fixture::new().await;
+    f.state.lock().unwrap().caret_unreadable = true;
+    let look = f.look();
+    let r = f.call(
+        "act",
+        Fixture::request(&look, "editor", "typeText", "private input"),
+    );
+    assert_eq!(r["ok"], false, "{r}");
+    assert!(!r.to_string().contains("private input"));
+    let state = f.state.lock().unwrap();
+    assert_eq!(state.value, "prefix");
+    assert_eq!(state.replacements + state.insertions, 0);
+}
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn incomplete_reads_and_depth_cuts_are_explicit() {
+    let mut f = Fixture::new().await;
+    let r = f.call(
+        "look",
+        json!({"rootRef":f.root,"includeImage":false,"maxDepth":1}),
+    );
+    assert_eq!(r["result"]["outline"]["truncated"], true, "{r}");
+    f.state.lock().unwrap().broken = true;
+    let r = f.look();
+    assert_eq!(r["outline"]["truncated"], true, "{r}");
+    let r = f.call(
+        "atspiWaitFor",
+        json!({"rootRef":f.root,"text":"missing","gone":true,"timeoutMs":100}),
+    );
+    assert_eq!(
+        r["result"]["found"], false,
+        "Unread children cannot prove absence: {r}"
+    );
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn scoped_observations_keep_a_visible_root_and_proven_window_ancestry() {
+    let mut f = Fixture::new().await;
+    let look = f.look();
+    let request = Fixture::request(&look, "Save draft", "press", "");
+    let scoped = f.call("look", json!({"rootRef":f.root,"includeImage":false,"baseLookId":look["lookId"],"scopeRef":request["target"]["ref"]}));
+    assert_eq!(
