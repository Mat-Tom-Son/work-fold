+    let acted = f.call("act", json!({"lookId":scoped["result"]["lookId"],"action":"press","target":{"ref":scoped["result"]["outline"]["ref"]},"policy":"ax_only"}));
+    assert_eq!(acted["result"]["outcome"], "unknown", "{acted}");
+    assert_eq!(f.state.lock().unwrap().effects, 1);
+}
