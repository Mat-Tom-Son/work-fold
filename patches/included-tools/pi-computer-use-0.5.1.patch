+import Foundation
+import ApplicationServices
+import Darwin
+
+/// A request stays cancellable while waiting for a lock or emitting an input
+/// sequence. Closing the caller's socket withdraws all not-yet-dispatched work.
+final class RequestExecutionGuard {
+    private let socket: Int32?
+    private let inputGeneration: () -> UInt64
+    private let initialGeneration: UInt64
+
+    init(socket: Int32?, inputGeneration: @escaping () -> UInt64 = { 0 }) {
+        self.socket = socket
+        self.inputGeneration = inputGeneration
+        self.initialGeneration = inputGeneration()
+    }
+
+    func check() throws {
+        if inputGeneration() != initialGeneration {
+            throw BridgeFailure(message: "Computer input stopped because the person took over. The last operation may have partially completed; observe before continuing.", code: "human_takeover")
+        }
+        if let socket {
+            var byte: UInt8 = 0
+            let count = recv(socket, &byte, 1, MSG_PEEK | MSG_DONTWAIT)
+            if count == 0 || (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+                throw BridgeFailure(message: "Computer request cancelled. The last operation may have partially completed; observe before continuing.", code: "request_cancelled")
+            }
+        }
+    }
+}
+
+/// Observe human input only during active requested mutations. Never suppress
+/// keyboard or mouse events. Helper-generated events carry a private marker so
+/// one request cannot cancel another merely by emitting its own input.
+final class HumanInputMonitor {
+    static let eventMarker: Int64 = 0x50494355494E5054
+    private let lock = NSLock()
+    private var generation: UInt64 = 0
+    private var users = 0
+    private var tap: CFMachPort?
+    private var source: CFRunLoopSource?
+
+    func currentGeneration() -> UInt64 {
+        lock.lock(); defer { lock.unlock() }
+        return generation
+    }
+
+    func noteHumanInput() {
+        lock.lock(); generation &+= 1; lock.unlock()
+    }
+
+    func begin() throws {
+        var failure: Error?
+        let install = {
+            self.lock.lock()
+            defer { self.lock.unlock() }
+            if self.users > 0 { self.users += 1; return }
+            let types: [CGEventType] = [.keyDown, .flagsChanged, .leftMouseDown, .rightMouseDown, .otherMouseDown, .mouseMoved, .leftMouseDragged, .rightMouseDragged, .otherMouseDragged, .scrollWheel]
+            let mask = types.reduce(CGEventMask(0)) { $0 | (CGEventMask(1) << $1.rawValue) }
+            let callback: CGEventTapCallBack = { _, type, event, userInfo in
+                guard let userInfo else { return Unmanaged.passUnretained(event) }
+                let monitor = Unmanaged<HumanInputMonitor>.fromOpaque(userInfo).takeUnretainedValue()
+                if type == .tapDisabledByTimeout || type == .tapDisabledByUserInput {
+                    // A missing monitor cannot honestly promise takeover. Mark
+                    // active requests cancelled; a later request can reinstall.
+                    monitor.noteHumanInput()
+                } else if event.getIntegerValueField(.eventSourceUserData) != HumanInputMonitor.eventMarker && event.getIntegerValueField(.eventSourceUnixProcessID) != Int64(getpid()) {
+                    monitor.noteHumanInput()
+                }
+                return Unmanaged.passUnretained(event)
+            }
+            guard let tap = CGEvent.tapCreate(tap: .cgSessionEventTap, place: .headInsertEventTap, options: .listenOnly, eventsOfInterest: mask, callback: callback, userInfo: Unmanaged.passUnretained(self).toOpaque()) else {
+                failure = BridgeFailure(message: "Computer input requires Accessibility access so human takeover can be observed.", code: "takeover_monitor_unavailable")
+                return
+            }
+            guard let source = CFMachPortCreateRunLoopSource(kCFAllocatorDefault, tap, 0) else {
+                failure = BridgeFailure(message: "Could not start the human-input monitor.", code: "takeover_monitor_unavailable")
+                return
+            }
+            self.tap = tap; self.source = source; self.users = 1
+            CFRunLoopAddSource(CFRunLoopGetMain(), source, .commonModes)
+            CGEvent.tapEnable(tap: tap, enable: true)
+        }
+        if Thread.isMainThread { install() } else { DispatchQueue.main.sync(execute: install) }
+        if let failure { throw failure }
+    }
+
+    func end() {
+        let remove = {
+            self.lock.lock(); defer { self.lock.unlock() }
+            guard self.users > 0 else { return }
+            self.users -= 1
+            guard self.users == 0 else { return }
+            if let tap = self.tap { CGEvent.tapEnable(tap: tap, enable: false) }
+            if let source = self.source { CFRunLoopRemoveSource(CFRunLoopGetMain(), source, .commonModes) }
+            self.source = nil; self.tap = nil
+        }
+        if Thread.isMainThread { remove() } else { DispatchQueue.main.sync(execute: remove) }
+    }
+}
