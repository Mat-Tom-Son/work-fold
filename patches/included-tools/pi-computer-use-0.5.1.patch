diff --git a/native/linux/bridge-rs/src/atspi/actions.rs b/native/linux/bridge-rs/src/atspi/actions.rs
new file mode 100644
index 0000000..407ef59
--- /dev/null
+++ b/native/linux/bridge-rs/src/atspi/actions.rs
@@ -0,0 +1,195 @@
+use super::*;
+
+fn absent(message: &str) -> ProtocolError {
+    ProtocolError::new(message, ErrorCode::CapabilityDeferred)
+}
+fn uncertain() -> ProtocolError {
+    ProtocolError::new("The accessibility operation may have taken effect. Observe before continuing; do not automatically repeat it.", ErrorCode::InterruptedUnknown)
+}
+fn preflight(message: &str) -> ProtocolError {
+    ProtocolError::new(message, ErrorCode::InvalidRequest)
+}
+fn result(outcome: &str, value: Option<&str>) -> Value {
+    let mut result = json!({"outcome":outcome,"performed":{"grounding":"description","delivery":"ax","deltaSource":"snapshot"}});
+    if let Some(value) = value {
+        result["evidence"] = json!({"value":value});
+    }
+    result
+}
+
+impl AtspiClient {
+    pub async fn press(&self, node: &NodeSnapshot) -> Result<Value, ProtocolError> {
+        if !node.interfaces.contains(ACTION) {
+            return Err(absent("Target does not expose the AT-SPI Action interface"));
+        }
+        let proxy = self.proxy(&node.accessible, ACTION).await?;
+        let count = bounded_action_count(Some(
+            proxy
+                .get_property::<i32>("NActions")
+                .await
+                .map_err(atspi_error)?,
+        ))?;
+        let mut names = Vec::new();
+        if count > 1 {
+            for index in 0..count {
+                names.push(
+                    proxy
+                        .call::<_, _, String>("GetName", &(index as i32))
+                        .await
+                        .map_err(atspi_error)?,
+                );
+            }
+        }
+        let index = selected_action_index(count, &names)
+            .ok_or_else(|| absent("Target advertises no activation action"))?;
+        let accepted: bool = proxy
+            .call("DoAction", &index)
+            .await
+            .map_err(|_| uncertain())?;
+        // A completed dispatch is not an independently observed outcome.
+        if accepted {
+            Ok(result("unknown", None))
+        } else {
+            Err(uncertain())
+        }
+    }
+
+    async fn readable_value(&self, node: &NodeSnapshot) -> Option<String> {
+        if node.is_secure || !node.interfaces.contains(TEXT) {
+            None
+        } else {
+            self.read_text(&node.accessible).await.ok()
+        }
+    }
+
+    async fn text_result(
+        &self,
+        node: &NodeSnapshot,
+        before: Option<&str>,
+        expected: Option<&str>,
+    ) -> Value {
+        let value = self.readable_value(node).await;
+        let outcome = match (value.as_deref(), expected) {
+            (Some(actual), Some(expected)) if actual == expected => "worked",
+            (Some(actual), _) if before == Some(actual) => "didnt",
+            _ => "unknown",
+        };
+        result(outcome, value.as_deref())
+    }
+
+    pub async fn set_text(&self, node: &NodeSnapshot, text: &str) -> Result<Value, ProtocolError> {
+        if !node.interfaces.contains(EDITABLE_TEXT) {
+            return Err(absent(
+                "Target does not expose the AT-SPI EditableText interface",
+            ));
+        }
+        let before = self.readable_value(node).await;
+        let proxy = self.proxy(&node.accessible, EDITABLE_TEXT).await?;
+        let _accepted: bool = proxy
+            .call("SetTextContents", &text)
+            .await
+            .map_err(|_| uncertain())?;
+        Ok(self.text_result(node, before.as_deref(), Some(text)).await)
+    }
+
+    /// Insert at the live caret, replacing only an explicitly selected range.
+    /// All offsets and input are validated before a selection is removed.
+    pub async fn insert_text(
+        &self,
+        node: &NodeSnapshot,
+        text: &str,
+        toolkit: &str,
+    ) -> Result<Value, ProtocolError> {
+        if !node.interfaces.contains(EDITABLE_TEXT) {
+            return Err(absent(
+                "Target does not expose the AT-SPI EditableText interface",
+            ));
+        }
+        if !node.interfaces.contains(TEXT) {
+            return Err(preflight(
+                "Semantic insertion requires a readable caret and selection",
+            ));
+        }
+        let proxy = self.proxy(&node.accessible, TEXT).await?;
+        let caret: i32 = proxy
+            .get_property("CaretOffset")
+            .await
+            .map_err(|_| preflight("The caret is unavailable; no text was entered"))?;
+        let count: i32 = proxy
+            .call("GetNSelections", &())
+            .await
+            .map_err(|_| preflight("The selection is unavailable; no text was entered"))?;
+        if caret < 0 || !(0..=1).contains(&count) {
+            return Err(preflight(
+                "The caret or selection is ambiguous; no text was entered",
+            ));
+        }
+        let (start, end) = if count == 1 {
+            let (a, b): (i32, i32) = proxy
+                .call("GetSelection", &0i32)
+                .await
+                .map_err(|_| preflight("The selection is unavailable; no text was entered"))?;
+            (a.min(b), a.max(b))
+        } else {
+            (caret, caret)
+        };
+        if start < 0 {
+            return Err(preflight(
+                "The selection offset is invalid; no text was entered",
+            ));
+        }
+        let length = if toolkit.to_lowercase().starts_with("qt") {
+            text.encode_utf16().count()
+        } else {
+            text.len()
+        };
+        let length = i32::try_from(length).map_err(|_| preflight("The input text is too long"))?;
+        let before = self.readable_value(node).await;
+        let expected = match before.as_deref() {
+            Some(old) => {
+                let chars: Vec<char> = old.chars().collect();
+                if end as usize > chars.len() || caret as usize > chars.len() {
+                    return Err(preflight("The selection lies outside the current text"));
+                }
+                Some(
+                    chars[..start as usize]
+                        .iter()
+                        .chain(text.chars().collect::<Vec<_>>().iter())
+                        .chain(chars[end as usize..].iter())
+                        .collect::<String>(),
+                )
+            }
+            None => None,
+        };
+        if text.is_empty() && start == end {
+            return Ok(result("worked", before.as_deref()));
+        }
+        let editable = self.proxy(&node.accessible, EDITABLE_TEXT).await?;
+        let deleted = start < end;
+        if deleted {
+            let accepted: bool = editable
+                .call("DeleteText", &(start, end))
+                .await
+                .map_err(|_| uncertain())?;
+            if !accepted {
+                return Err(uncertain());
+            }
+        }
+        if !text.is_empty() {
+            let accepted: bool = editable
+                .call("InsertText", &(start, text, length))
+                .await
+                .map_err(|_| uncertain())?;
+            if !accepted {
+                return Err(uncertain());
+            }
+        }
+        let checked = self
+            .text_result(node, before.as_deref(), expected.as_deref())
+            .await;
+        if deleted && checked["outcome"] != "worked" {
+            return Err(uncertain());
+        }
+        Ok(checked)
+    }
+}
