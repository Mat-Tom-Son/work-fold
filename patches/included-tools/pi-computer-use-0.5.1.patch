+struct BridgeFailure: Error { let message: String; let code: String }
+@main struct RequestLifecycleTests {
+ static func main() throws {
+  var sockets:[Int32]=[0,0]; precondition(socketpair(AF_UNIX,SOCK_STREAM,0,&sockets)==0)
+  defer{close(sockets[0])}
+  let request=RequestExecutionGuard(socket:sockets[0]);try request.check()
+  close(sockets[1])
+  do{try request.check();preconditionFailure("closed peer accepted")}catch let e as BridgeFailure{precondition(e.code=="request_cancelled")}
+  var generation:UInt64=0
+  let human=RequestExecutionGuard(socket:nil,inputGeneration:{generation});try human.check();generation+=1
+  do{try human.check();preconditionFailure("human takeover accepted")}catch let e as BridgeFailure{precondition(e.code=="human_takeover")}
+  var failedFocusAttempts=0,failedFocusEvents=0
+  do{
+   try ForegroundInputPreflight.require(preserveFocus:false,isSelectedTarget:{false},focusTarget:{failedFocusAttempts+=1},waitForFocus:{},checkRequestActive:{})
+   failedFocusEvents+=1;preconditionFailure("unfocused target accepted")
+  }catch let e as BridgeFailure{precondition(e.code=="focus_preflight_failed")}
+  precondition(failedFocusAttempts==1);precondition(failedFocusEvents==0)
+  var preservedFocusAttempts=0
+  do{
+   try ForegroundInputPreflight.require(preserveFocus:true,isSelectedTarget:{false},focusTarget:{preservedFocusAttempts+=1},waitForFocus:{},checkRequestActive:{})
+   preconditionFailure("lost preserved focus accepted")
+  }catch let e as BridgeFailure{precondition(e.code=="focus_preflight_failed")}
+  precondition(preservedFocusAttempts==0)
+  var selected=false,validFocusEvents=0
+  try ForegroundInputPreflight.require(preserveFocus:false,isSelectedTarget:{selected},focusTarget:{selected=true},waitForFocus:{},checkRequestActive:{})
+  validFocusEvents+=1
+  precondition(validFocusEvents==1)
+  func permits(_ parents:[String:String],_ observed:String,_ target:String,_ window:String,_ ui:String?)->Bool{ForegroundInputFocusPath.permits(observedRoot:observed,targetContainer:target,focusedWindow:window,focusedUI:ui,parent:{parents[$0]},same:==,isInputContainer:{["browser","open","go-to","other-modal","nested-modal"].contains($0)})}
+  let nestedParents=["field":"go-to","go-to":"open","open":"browser"]
