--- /dev/null
+++ b/native/macos/request_lifecycle.swift
@@ -0,0 +1,100 @@
+import Foundation
+import ApplicationServices
+import Darwin
+
+/// A request stays cancellable while waiting for a lock or emitting an input
+/// sequence. Closing the caller's socket withdraws all not-yet-dispatched work.
+final class RequestExecutionGuard {
+    private let socket: Int32?
+    private let inputGeneration: () -> UInt64
+    private let initialGeneration: UInt64
+
+    init(socket: Int32?, inputGeneration: @escaping () -> UInt64 = { 0 }) {
+        self.socket = socket
+        self.inputGeneration = inputGeneration
+        self.initialGeneration = inputGeneration()
+    }
+
+    func check() throws {
+        if inputGeneration() != initialGeneration {
+            throw BridgeFailure(message: "Computer input stopped because the person took over. The last operation may have partially completed; observe before continuing.", code: "human_takeover")
+        }
+        if let socket {
+            var byte: UInt8 = 0
+            let count = recv(socket, &byte, 1, MSG_PEEK | MSG_DONTWAIT)
+            if count == 0 || (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
