+      await macosHelper.ensureInstalled(options.signal);
+      if (!(await macosHelper.ensureDaemon(options.signal))) throw new Error("Computer helper did not start.");
+      await macosHelper.ensureProtocol(options.signal);
+    }
+    const diagnostics = await macosHelper.daemonCommand<any>("diagnostics", {}, 1_000, options.signal);
+    connected = true;
+    if (diagnostics.protocolVersion !== 7 || !diagnostics.executablePath || await realpath(diagnostics.executablePath) !== await realpath(HELPER_APP_EXECUTABLE_PATH)) {
+      throw new Error("The running computer helper does not match this application. Recheck setup while no Assistant turn is running.");
+    }
+    const permissions = await macosHelper.daemonCommand<any>("checkPermissions", {}, 6_000, options.signal);
+    return {
+      status: permissions.accessibility && permissions.screenRecordingCapturable ? "ready" as const : "setup_required" as const,
+      supportedOS: true,
+      helper: { appPath: HELPER_APP_PATH, executablePath: diagnostics.executablePath, bundleId: permissions.source?.bundleId, name: permissions.source?.bundleName, protocolVersion: diagnostics.protocolVersion, pid: diagnostics.pid },
+      accessibility: permissions.accessibility === true,
+      screenRecording: permissions.screenRecordingCapturable === true,
+      screenRecordingPreflight: permissions.screenRecordingPreflight === true,
+      source: permissions.source,
+    };
+  } catch (error) {
+    if (options.signal?.aborted) throw error;
+    return { status: options.launch || connected ? "error" as const : "not_running" as const, supportedOS: true, helper: { appPath: HELPER_APP_PATH }, reason: error instanceof Error ? error.message : String(error) };
+  }
+}
+
+/** Only a trusted setup action calls this, never startup/catalog inspection. */
+export async function setupMacosComputerUse(action: "request-permissions" | "accessibility" | "screen-recording" | "recheck", signal?: AbortSignal) {
+  await macosHelper.ensureInstalled(signal);
+  if (!(await macosHelper.ensureDaemon(signal))) throw new Error("Computer helper did not start.");
+  await macosHelper.ensureProtocol(signal);
+  if (action === "request-permissions") await macosHelper.command("registerPermissions", {}, { signal, timeoutMs: 15_000 });
+  else if (action === "accessibility" || action === "screen-recording") await macosHelper.command("openPermissionPane", { kind: action === "accessibility" ? "accessibility" : "screenRecording" }, { signal });
+  else if (action === "recheck") await macosHelper.restart(signal);
+  else throw new Error("Unknown computer setup action.");
+  return await probeMacosComputerUse({ signal });
+}
