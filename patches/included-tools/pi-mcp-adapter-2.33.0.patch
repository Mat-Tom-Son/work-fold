+const scopedAgentDir = new AsyncLocalStorage<string>();
+/** Bind native adapter caches to the host's explicit Pi scope without changing process environment. */
+export function withAgentDir<T>(agentDir: string | undefined, operation: () => T): T {
+  return agentDir ? scopedAgentDir.run(resolve(agentDir), operation) : operation();
+}
+export function scopeExtensionApi(pi: ExtensionAPI, agentDir: string): ExtensionAPI {
+  const wrap = (callback: (...args: any[]) => any) => function(this: unknown, ...args: any[]) {
+    return withAgentDir(agentDir, () => callback.apply(this, args));
+  };
+  const wrapDefinition = (definition: Record<string, any>) => Object.fromEntries(Object.entries(definition).map(([key, value]) => [key, typeof value === "function" ? wrap(value) : value]));
+  const events = new Proxy(pi.events, { get(target, key) {
+    if (key === "on") return (event: string, callback: (...args: any[]) => any) => target.on(event, wrap(callback));
+    const value = Reflect.get(target, key); return typeof value === "function" ? value.bind(target) : value;
+  } });
+  return new Proxy(pi, { get(target, key) {
+    if (key === "events") return events;
+    if (key === "on") return (event: any, callback: (...args: any[]) => any) => (target.on as any)(event, wrap(callback));
+    if (key === "registerTool") return (definition: any) => target.registerTool(wrapDefinition(definition) as any);
+    if (key === "registerCommand") return (name: string, definition: any) => target.registerCommand(name, wrapDefinition(definition) as any);
+    const value = Reflect.get(target, key); return typeof value === "function" ? value.bind(target) : value;
+  } });
+}
+
+export function getScopedAgentDir(): string | undefined { return scopedAgentDir.getStore(); }
+
 export function getAgentDir(): string {
+  const scoped = scopedAgentDir.getStore();
+  if (scoped) return scoped;
   const piConfig = readPiConfig();
   const name = piConfig?.name;
   const appName = typeof name === "string" && name.trim() ? name.trim() : "pi";
