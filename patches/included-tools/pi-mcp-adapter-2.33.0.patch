+/** Supported setup functions for trusted non-terminal hosts; never a model tool. */
+export {
+  authenticate,
+  createOAuthRuntime,
+  getAuthStatus,
+  hasPendingAuth,
+  removeAuth,
+  shutdownOAuth,
+  type AuthenticateOptions,
+  type McpOAuthRuntime,
+} from "./mcp-auth-flow.ts";
+export { getAuthStorageOptions, type AuthStorageOptions } from "./mcp-auth.ts";
+export {
+  inspectBearerTokenForUrl,
+  saveBearerTokenForUrl,
+  removeBearerToken,
+  type BearerCredentialStatus,
+} from "./mcp-bearer-store.ts";
+export { mergeConfigs as mergeMcpConfigs, loadMcpConfigFromFiles, writeSharedServerEntry, removeSharedServerEntry } from "./config.ts";
+import { inspectAuthForUrl, type AuthStorageOptions } from "./mcp-auth.ts";
+/** Content-free URL-bound setup status; never exposes token records. */
+export function inspectOAuthForUrl(name: string, url: string, options?: AuthStorageOptions): { status: "present" | "expired" | "missing" | "unavailable"; message?: string } {
+  const result = inspectAuthForUrl(name, url, options);
+  if (result.status === "unavailable") return result;
+  if (result.status === "absent" || !result.entry.tokens) return { status: "missing" };
+  return { status: result.entry.tokens.expiresAt && result.entry.tokens.expiresAt < Date.now() / 1000 ? "expired" : "present" };
+}
+export { withAgentDir } from "./agent-dir.ts";
+export { McpServerManager } from "./server-manager.ts";
