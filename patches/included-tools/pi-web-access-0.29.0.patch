+
+/** Bound provider result bodies with the same 5 MiB ceiling as ordinary HTTP extraction. */
+export async function readSearchResponseText(response: Response): Promise<string> {
+	const maxBytes = 5 * 1024 * 1024;
+	const reader = response.body?.getReader();
+	if (!reader) return "";
+	const chunks: Uint8Array[] = [];
+	let size = 0;
+	try {
+		while (true) {
+			const { done, value } = await reader.read();
+			if (done) break;
+			size += value.byteLength;
+			if (size > maxBytes) {
+				await reader.cancel();
+				throw new Error("Search response exceeds the 5 MiB download limit");
+			}
+			chunks.push(value);
+		}
+	} finally {
+		reader.releaseLock();
+	}
+	return Buffer.concat(chunks).toString("utf8");
+}
 
